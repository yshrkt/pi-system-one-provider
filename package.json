{
  "name": "pi-system-one-provider",
  "version": "0.1.1",
  "description": "Pi provider extension for configurable System One classifier endpoints",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yshrkt/pi-system-one-provider.git"
  },
  "keywords": ["pi-package", "pi", "system-one", "classifier"],
  "files": ["extensions", "src", "skills", "examples", "README.md", "LICENSE"],
  "pi": {
